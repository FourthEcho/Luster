option.tonemapRight.comment=Tonemapping operator used for the right half of the screen while the tonemap comparison is enabled.
value.tonemapRight.tonemapAcesFit=ACES Fit
value.tonemapRight.tonemapAcesFull=ACES Full
value.tonemapRight.tonemapLottes=Lottes
value.tonemapRight.tonemapHejlBurgess=Hejl-Burgess
value.tonemapRight.tonemapHejl2015=Hejl 2015
value.tonemapRight.tonemapUncharted2=Uncharted 2

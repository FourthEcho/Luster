# Screen-space global illumination
option.SSGI                                = Screen-Space Global Illumination
option.SSGI.comment                        = Gathers bounce light from the lit scene in screen space. Adds indirect light with color bleeding to shadowed areas
option.SSGI_TEMPORAL_ACCUMULATION          = Temporal Accumlation
option.SSGI_TEMPORAL_ACCUMULATION.comment  = Accumulates SSGI over frames with reprojection and depth rejection. Smooths noise but can ghost slightly behind moving objects
option.SSGI_INTENSITY                      = SSGI Intensity
option.SSGI_INTENSITY.comment              = Adjusts the strength of the bounce light
option.SSGI_RADIUS                         = SSGI Radius
option.SSGI_RADIUS.comment                 = How far bounce rays travel, in blocks. Larger radii spread light further but leak through thin geometry
option.SSGI_RAY_STEPS                      = SSGI Ray Steps
option.SSGI_RAY_STEPS.comment              = Steps taken per bounce ray. More steps find more hits but cost performance
option.SSGI_BOUNCES                        = SSGI Bounces
option.SSGI_BOUNCES.comment                = Number of true light bounces. Each bounce adds a full screen pass. 1 is cheapest, 3 gives deep multi-bounce color bleed
value.SSGI_BOUNCES.1                       = 1 Bounce
value.SSGI_BOUNCES.2                       = 2 Bounces
value.SSGI_BOUNCES.3                       = 3 Bounces
option.SSGI_TEMPORAL_WEIGHT                = SSGI Temporal Weight
option.SSGI_TEMPORAL_WEIGHT.comment        = How much history is blended in per frame. Higher is smoother but ghosts more
option.SSGI_FILTER_RADIUS                  = SSGI Filter Radius
option.SSGI_FILTER_RADIUS.comment          = Radius of the depth-aware blur applied to the bounce light. 0 disables the filter
value.SSGI_FILTER_RADIUS.0                 = Off
value.SSGI_FILTER_RADIUS.1                 = 1 Pixel
value.SSGI_FILTER_RADIUS.2                 = 2 Pixels
value.SSGI_FILTER_RADIUS.3                 = 3 Pixels
option.ATMOSPHERE_SATURATION_BOOST                      = Atmosphere Saturation Boost
option.ATMOSPHERE_SATURATION_BOOST.comment              = Increases the saturation of the sky and sunlight color depending on the time of day
option.STARS                           = Enabled
option.STARS.comment                   = Stars in the night sky. Low performance impact
option.STARS_INTENSITY                 = Intensity
option.STARS_INTENSITY.comment         = Controls the brightness of stars in the night sky
option.STARS_COVERAGE                  = Coverage
option.STARS_COVERAGE.comment          = Controls the number of stars in the night sky
option.GALAXY                          = Galaxy
option.GALAXY.comment                  = Galaxy image in the night sky
option.GALAXY_INTENSITY                = Galaxy Intensity
option.GALAXY_INTENSITY.comment        = Controls the brightness of the galaxy in the night sky
option.CREPUSCULAR_RAYS                = Enabled
option.CREPUSCULAR_RAYS.comment = Adjusts enabled.
option.CREPUSCULAR_RAYS_INTENSITY      = Intensity
option.CREPUSCULAR_RAYS_INTENSITY.comment = Adjusts intensity.
option.CREPUSCULAR_RAYS_STEPS_HORIZON  = Step Count - Horizon
option.CREPUSCULAR_RAYS_STEPS_HORIZON.comment = Adjusts step count - horizon.
option.CREPUSCULAR_RAYS_STEPS_ZENITH   = Step Count - Zenith
option.CREPUSCULAR_RAYS_STEPS_ZENITH.comment = Adjusts step count - zenith.

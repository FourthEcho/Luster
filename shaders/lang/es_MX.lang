value.MATERIAL_MAPPING_MODE.MATERIAL_MAPPING_NORMALS_ONLY=Normals Only
value.MATERIAL_MAPPING_MODE.MATERIAL_MAPPING_SPECULAR_NORMALS=Specular + Normals


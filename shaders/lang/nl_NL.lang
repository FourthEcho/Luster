option.INDIRECT_LIGHTING_INTENSITY=Indirect Lighting Intensity
option.INDIRECT_LIGHTING_INTENSITY.comment = Brightness multiplier for the indirect (bounced) lighting contribution.
option.RESTIR_TEMPORAL_REUSE=Temporal Reuse
option.RESTIR_TEMPORAL_REUSE.comment = Controls temporal reuse.
option.RESTIR_SPATIAL_REUSE=Spatial Reuse
option.RESTIR_SPATIAL_REUSE.comment = Controls spatial reuse.
option.RESTIR_SPATIAL_SAMPLES=Spatial Reuse Samples
option.RESTIR_SPATIAL_SAMPLES.comment = Controls spatial reuse samples.
option.RESTIR_SPATIAL_RADIUS=Spatial Reuse Radius
option.RESTIR_SPATIAL_RADIUS.comment = Controls spatial reuse radius.
option.RESTIR_INITIAL_RAY_STEPS=Initial Ray Steps

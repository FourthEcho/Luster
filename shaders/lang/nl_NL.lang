option.RESTIR_REFINEMENT_STEPS=Refinement Steps
option.RESTIR_REFINEMENT_STEPS.comment = Controls refinement steps.
option.RESTIR_ACCUMULATION_FRAMES=Accumulation Frames
option.RESTIR_ACCUMULATION_FRAMES.comment = Controls accumulation frames.
option.A_SVGF=A-SVGF

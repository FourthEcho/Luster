option.CLOUDS_CUMULUS                       = Cumulus Wolken
option.CLOUDS_CUMULUS.comment               = Laaghangende volumetrische wolken die cumulus-wolken moeten voorstellen.
option.CLOUDS_CUMULUS_PRIMARY_STEPS_H       = Primaire Stappen - Horizon
option.CLOUDS_CUMULUS_PRIMARY_STEPS_H.comment = Controls primary steps - horizon.
option.CLOUDS_CUMULUS_PRIMARY_STEPS_Z       = Primaire Stappen - Zenith
option.CLOUDS_CUMULUS_PRIMARY_STEPS_Z.comment = Controls primary steps - zenith.
option.CLOUDS_CUMULUS_LIGHTING_STEPS        = Licht Stappen
option.CLOUDS_CUMULUS_LIGHTING_STEPS.comment = Controls lighting steps.
option.CLOUDS_CUMULUS_AMBIENT_STEPS         = Omgevings Stappen
option.CLOUDS_CUMULUS_AMBIENT_STEPS.comment = Controls ambient steps.
option.CLOUDS_CUMULUS_ALTITUDE              = Hoogte
option.CLOUDS_CUMULUS_ALTITUDE.comment = Controls altitude.
suffix.CLOUDS_CUMULUS_ALTITUDE              = m
option.CLOUDS_CUMULUS_THICKNESS             = Dikte
option.CLOUDS_CUMULUS_THICKNESS.comment = Controls thickness.
option.CLOUDS_CUMULUS_DENSITY               = Dichtheid
option.CLOUDS_CUMULUS_DENSITY.comment = Controls density.
option.CLOUDS_CUMULUS_COVERAGE              = Dekking
option.CLOUDS_CUMULUS_COVERAGE.comment = Controls coverage.
option.CLOUDS_CUMULUS_SIZE                  = Grootte
option.CLOUDS_CUMULUS_SIZE.comment = Controls size.
option.CLOUDS_CUMULUS_DETAIL_STRENGTH       = Detail Intensiteit
option.CLOUDS_CUMULUS_DETAIL_STRENGTH.comment = Controls detail strength.
